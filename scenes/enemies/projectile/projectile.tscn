[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scenes/enemies/projectile/projectile.gd" id="1_proj"]
[ext_resource type="Script" path="res://scenes/components/hitbox.gd" id="2_hitbox"]
[ext_resource type="Script" path="res://scenes/components/hurtbox.gd" id="3_hurtbox"]

[sub_resource type="CircleShape2D" id="orb_shape"]
radius = 4.0

[sub_resource type="CircleShape2D" id="hurt_shape"]
radius = 6.0

; ---------------------------------------------------------------
; Physics layer reference:
;   World=1  Player=2  Enemy=4  PlayerHitbox=8
;   EnemyHitbox=16  PlayerHurtbox=32  EnemyHurtbox=64
;
; Root: detects World bodies only (to pop on walls/floors).
; Hitbox: EnemyHitbox (16) -> PlayerHurtbox (32); switched to
;         PlayerHitbox (8) -> EnemyHurtbox (64) when hit back.
; Hurtbox: EnemyHurtbox (64), slightly larger than the orb so
;          it's fair to swat.
; Hitbox/Hurtbox use the component scripts directly (not the
; component scenes) so the shapes can be orb-sized.
; ---------------------------------------------------------------

[node name="Projectile" type="Area2D"]
collision_layer = 0
collision_mask = 1
monitorable = false
script = ExtResource("1_proj")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("orb_shape")

[node name="Hitbox" type="Area2D" parent="."]
collision_layer = 16
collision_mask = 32
monitoring = false
monitorable = false
script = ExtResource("2_hitbox")
damage = 1
knockback_force = 160.0

[node name="CollisionShape2D" type="CollisionShape2D" parent="Hitbox"]
shape = SubResource("orb_shape")

[node name="Hurtbox" type="Area2D" parent="."]
collision_layer = 64
collision_mask = 0
script = ExtResource("3_hurtbox")

[node name="CollisionShape2D" type="CollisionShape2D" parent="Hurtbox"]
shape = SubResource("hurt_shape")
